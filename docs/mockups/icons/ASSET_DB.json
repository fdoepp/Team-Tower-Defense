{
  "version": 2,
  "description": "Kanonische Icon-Pfade für Matchday. Deploy und neue Spiele laden ausschließlich diese Dateien unter game/public/icons/.",
  "ui": {
    "slotEmpty": {
      "path": "ui/slot-empty.png",
      "role": "bauplatz",
      "style": "pfosten-seil-vorschlag-c",
      "orientation": "axis-aligned",
      "control": "grey",
      "locked": true,
      "notes": "Deploy-Default = parallel ohne Standarte. Alias von slot-empty-parallel.png."
    },
    "slotEmptyParallel": {
      "path": "ui/slot-empty-parallel.png",
      "role": "bauplatz",
      "control": "grey",
      "locked": true,
      "notes": "Neutral/grau — Standarte aus."
    },
    "slotEmptyIso": {
      "path": "ui/slot-empty-iso.png",
      "role": "bauplatz",
      "control": "grey",
      "locked": true,
      "notes": "Iso-Neutrale Variante (Orientierungs-Alternative)."
    },
    "slotEmptyParallelBlue": {
      "path": "ui/slot-empty-parallel-blue.png",
      "role": "bauplatz-eigen",
      "team": "ksc",
      "control": "blue",
      "locked": true,
      "notes": "Teamkontrolle KSC — Standarte blau ein."
    },
    "slotEmptyParallelRed": {
      "path": "ui/slot-empty-parallel-red.png",
      "role": "bauplatz-eigen",
      "team": "vfb",
      "control": "red",
      "locked": true,
      "notes": "Teamkontrolle VfB — Standarte rot ein."
    },
    "slotEmptyIsoBlue": {
      "path": "ui/slot-empty-iso-blue.png",
      "role": "bauplatz-eigen",
      "team": "ksc",
      "control": "blue",
      "locked": true
    },
    "slotEmptyIsoRed": {
      "path": "ui/slot-empty-iso-red.png",
      "role": "bauplatz-eigen",
      "team": "vfb",
      "control": "red",
      "locked": true
    },
    "pennantKsc": {
      "path": "ui/pennant-ksc.png",
      "team": "ksc",
      "color": "blue-white",
      "role": "standarte",
      "style": "holzpfosten-streifenfahne-vorschlag-a",
      "locked": true,
      "notes": "Heim-Besitz/Front-Marker. Kein Logo, kein Chrom-Ständer."
    },
    "pennantVfb": {
      "path": "ui/pennant-vfb.png",
      "team": "vfb",
      "color": "red-white",
      "role": "standarte",
      "style": "holzpfosten-streifenfahne-vorschlag-a",
      "locked": true,
      "notes": "Gäste-Besitz/Front-Marker. Gleiche Form wie pennantKsc, nur rot-weiß."
    }
  },
  "runtimeBinding": {
    "module": "game/src/game/assets.ts",
    "keys": [
      "UI_ICONS.pennantKsc",
      "UI_ICONS.pennantVfb",
      "UI_ICONS.btnBauenAmber",
      "UI_ICONS.btnUpgradePurple",
      "slotEmptyIconPath",
      "standIconPath",
      "SLOT_EMPTY_ORIENTATION"
    ],
    "render": "drawBaustelle → slotControlForPlot → slotEmptyIconPath; drawTerritoryPennants für gebaute Buden; Action Cards → standIconPath",
    "autoSwap": {
      "teamControl": "Standarte-Farbe ein (blue/red Plot-Icon)",
      "greyControl": "Standarte aus (neutrales Plot-Icon)",
      "triggers": [
        "slot.owner",
        "slot.greyNeutral",
        "blockOwner[blockId]",
        "inPlayerTerritory / inAiTerritory"
      ]
    },
    "actionCards": {
      "rule": "Neubau/Upgrade-Karten komponieren Icons soft über standIconPath — keine eingebackenen Gebäude-Kachel-PNGs. Neue Stand-PNGs unter stands/ greifen beim Preload.",
      "sync": [
        "syncPendingBuildUi",
        "syncUpgradeActionCard"
      ]
    }
  },
  "deploy": {
    "sourceDir": "game/public/icons/",
    "rule": "Jeder Build/Deploy und jede neue Match-Erstellung muss locked Standarten + Bauplatz-Varianten aus diesem Register preloaded verwenden. Runtime tauscht Bauplatz-Icons automatisch bei Team-/Grau-Kontrolle. Gebäude-Action-Cards laden Stand-Icons immer soft via standIconPath."
  }
}
