{
  "version": 2,
  "description": "Kanonische Icon-Pfade für Matchday. Deploy und neue Spiele laden ausschließlich diese Dateien unter game/public/icons/.",
  "ui": {
    "slotEmpty": {
      "path": "ui/slot-empty.png",
      "role": "bauplatz",
      "style": "pfosten-seil-vorschlag-c",
      "orientation": "perspective-floor",
      "control": "grey",
      "locked": true,
      "notes": "Deploy-Default = Stadionboden-Perspektive (vorn breiter, hinten schmaler). Alias von slot-empty-persp.png."
    },
    "slotEmptyParallel": {
      "path": "ui/slot-empty-parallel.png",
      "role": "bauplatz",
      "control": "grey",
      "orientation": "perspective-floor",
      "locked": true,
      "notes": "Runtime-Default-Pfad — Inhalt = Stadionboden-Perspektive (identisch slot-empty-persp.png)."
    },
    "slotEmptyIso": {
      "path": "ui/slot-empty-iso.png",
      "role": "bauplatz",
      "control": "grey",
      "locked": false,
      "notes": "Archiv/Alternative — isometrische Raute. Nicht Deploy-Default."
    },
    "slotEmptyParallelBlue": {
      "path": "ui/slot-empty-parallel-blue.png",
      "role": "bauplatz-eigen",
      "team": "ksc",
      "control": "blue",
      "orientation": "perspective-floor",
      "locked": true,
      "notes": "Runtime-Pfad = slot-empty-persp-blue.png"
    },
    "slotEmptyParallelRed": {
      "path": "ui/slot-empty-parallel-red.png",
      "role": "bauplatz-eigen",
      "team": "vfb",
      "control": "red",
      "orientation": "perspective-floor",
      "locked": true,
      "notes": "Runtime-Pfad = slot-empty-persp-red.png"
    },
    "slotEmptyIsoBlue": {
      "path": "ui/slot-empty-iso-blue.png",
      "role": "bauplatz-eigen",
      "team": "ksc",
      "control": "blue",
      "locked": true
    },
    "slotEmptyIsoRed": {
      "path": "ui/slot-empty-iso-red.png",
      "role": "bauplatz-eigen",
      "team": "vfb",
      "control": "red",
      "locked": true
    },
    "pennantKsc": {
      "path": "ui/pennant-ksc.png",
      "team": "ksc",
      "color": "blue-white",
      "role": "standarte",
      "style": "holzpfosten-streifenfahne-vorschlag-a",
      "locked": true,
      "notes": "Heim-Besitz/Front-Marker. Kein Logo, kein Chrom-Ständer."
    },
    "pennantVfb": {
      "path": "ui/pennant-vfb.png",
      "team": "vfb",
      "color": "red-white",
      "role": "standarte",
      "style": "holzpfosten-streifenfahne-vorschlag-a",
      "locked": true,
      "notes": "Gäste-Besitz/Front-Marker. Gleiche Form wie pennantKsc, nur rot-weiß."
    },
    "slotEmptyPersp": {
      "path": "ui/slot-empty-persp.png",
      "role": "bauplatz",
      "control": "grey",
      "orientation": "perspective-floor",
      "locked": true,
      "notes": "Trapez-Perspektive passend zum stadium-floodlight-derby-bg Bodenraster."
    },
    "slotEmptyPerspBlue": {
      "path": "ui/slot-empty-persp-blue.png",
      "role": "bauplatz-eigen",
      "team": "ksc",
      "control": "blue",
      "orientation": "perspective-floor",
      "locked": true
    },
    "slotEmptyPerspRed": {
      "path": "ui/slot-empty-persp-red.png",
      "role": "bauplatz-eigen",
      "team": "vfb",
      "control": "red",
      "orientation": "perspective-floor",
      "locked": true
    },
    "slotEmptyOrtho": {
      "path": "ui/slot-empty-ortho.png",
      "role": "bauplatz-archiv",
      "orientation": "axis-aligned",
      "locked": false,
      "notes": "Archiv: früheres gerades Parallel-Icon ohne Boden-Perspektive."
    }
  },
  "runtimeBinding": {
    "module": "game/src/game/assets.ts",
    "keys": [
      "UI_ICONS.pennantKsc",
      "UI_ICONS.pennantVfb",
      "UI_ICONS.btnBauenAmber",
      "UI_ICONS.btnUpgradePurple",
      "slotEmptyIconPath",
      "standIconPath",
      "SLOT_EMPTY_ORIENTATION"
    ],
    "render": "drawBaustelle → slotControlForPlot → slotEmptyIconPath; drawTerritoryPennants für gebaute Buden; Action Cards → standIconPath",
    "autoSwap": {
      "teamControl": "Standarte-Farbe ein (blue/red Plot-Icon)",
      "greyControl": "Standarte aus (neutrales Plot-Icon)",
      "triggers": [
        "slot.owner",
        "slot.greyNeutral",
        "blockOwner[blockId]",
        "inPlayerTerritory / inAiTerritory"
      ]
    },
    "actionCards": {
      "rule": "Gebäude- und Einheiten-Karten komponieren Icons soft (standIconPath / unitIconPath) und lesen Kosten/Stats live aus types.ts — keine eingebackenen Kachel-Werte.",
      "sync": [
        "syncPendingBuildUi",
        "syncUpgradeActionCard",
        "syncUnitActionCards"
      ],
      "liveBalance": [
        "BUILD_COST",
        "UPGRADE_COST",
        "productionPerMinute",
        "BUY_COST",
        "STEWARD_HIRE_GOLD",
        "PYRO_FIGHT_MERCH",
        "HOOLIGAN_ORDER_BEER"
      ]
    }
  },
  "deploy": {
    "sourceDir": "game/public/icons/",
    "rule": "Jeder Build/Deploy und jede neue Match-Erstellung muss locked Standarten + Bauplatz-Perspektiv-Varianten (slot-empty-persp*) aus diesem Register preloaded verwenden. Runtime tauscht Bauplatz-Icons automatisch bei Team-/Grau-Kontrolle.",
    "slotDefault": "perspective-floor"
  },
  "uiFinal": {
    "sourceOfTruth": "docs/icons/ui-final/UI_FINAL_DB.json",
    "runtimeDir": "game/public/icons/ui-final/",
    "rule": "Final freigegebene UI-Elemente: alle Branches laden freigegebenes UI aus UI_FINAL_DB (released). Ablage nur nach manueller Freigabe + Validierung (freigestellt, preserveAspect).",
    "approve": "node scripts/ui-final/approve.mjs <id> --by <name>",
    "sync": "node scripts/ui-final/sync.mjs"
  }
}
