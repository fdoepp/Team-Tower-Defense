{
  "version": 2,
  "description": "Kanonische Icon-Pfade für Matchday. Deploy und neue Spiele laden ausschließlich diese Dateien unter game/public/icons/.",
  "ui": {
    "slotEmpty": {
      "path": "ui/slot-empty.png",
      "role": "bauplatz",
      "style": "pfosten-seil-vorschlag-c",
      "orientation": "axis-aligned",
      "control": "grey",
      "locked": true,
      "notes": "Deploy-Default = parallel ohne Standarte. Alias von slot-empty-parallel.png."
    },
    "slotEmptyParallel": {
      "path": "ui/slot-empty-parallel.png",
      "role": "bauplatz",
      "control": "grey",
      "locked": true,
      "notes": "Neutral/grau — Standarte aus."
    },
    "slotEmptyIso": {
      "path": "ui/slot-empty-iso.png",
      "role": "bauplatz",
      "control": "grey",
      "locked": true,
      "notes": "Iso-Neutrale Variante (Orientierungs-Alternative)."
    },
    "slotEmptyParallelBlue": {
      "path": "ui/slot-empty-parallel-blue.png",
      "role": "bauplatz-eigen",
      "team": "ksc",
      "control": "blue",
      "locked": true,
      "notes": "Teamkontrolle KSC — Standarte blau ein."
    },
    "slotEmptyParallelRed": {
      "path": "ui/slot-empty-parallel-red.png",
      "role": "bauplatz-eigen",
      "team": "vfb",
      "control": "red",
      "locked": true,
      "notes": "Teamkontrolle VfB — Standarte rot ein."
    },
    "slotEmptyIsoBlue": {
      "path": "ui/slot-empty-iso-blue.png",
      "role": "bauplatz-eigen",
      "team": "ksc",
      "control": "blue",
      "locked": true
    },
    "slotEmptyIsoRed": {
      "path": "ui/slot-empty-iso-red.png",
      "role": "bauplatz-eigen",
      "team": "vfb",
      "control": "red",
      "locked": true
    },
    "pennantKsc": {
      "path": "ui/pennant-ksc.png",
      "team": "ksc",
      "color": "blue-white",
      "role": "standarte",
      "style": "holzpfosten-streifenfahne-vorschlag-a",
      "locked": true,
      "notes": "Heim-Besitz/Front-Marker. Kein Logo, kein Chrom-Ständer."
    },
    "pennantVfb": {
      "path": "ui/pennant-vfb.png",
      "team": "vfb",
      "color": "red-white",
      "role": "standarte",
      "style": "holzpfosten-streifenfahne-vorschlag-a",
      "locked": true,
      "notes": "Gäste-Besitz/Front-Marker. Gleiche Form wie pennantKsc, nur rot-weiß."
    }
  },
  "runtimeBinding": {
    "module": "game/src/game/assets.ts",
    "keys": [
      "UI_ICONS.pennantKsc",
      "UI_ICONS.pennantVfb",
      "UI_ICONS.btnBauenAmber",
      "UI_ICONS.btnUpgradePurple",
      "slotEmptyIconPath",
      "standIconPath",
      "SLOT_EMPTY_ORIENTATION",
      "SCENE_ASSETS.stadiumBg",
      "tribuneIconPath",
      "unitHeadIconPath",
      "UI_ICONS.scoreboard"
    ],
    "render": "drawStadiumAtmosphere → drawImageCover(stadiumBg); drawBlocks → tribuneIconPath + drawIcon; drawScoreboard → scoreboard-top uniform AR; Personen-Rail → unitHeadIconPath; Action Cards → standIconPath / unitIconPath",
    "autoSwap": {
      "teamControl": "Standarte-Farbe ein (blue/red Plot-Icon)",
      "greyControl": "Standarte aus (neutrales Plot-Icon)",
      "triggers": [
        "slot.owner",
        "slot.greyNeutral",
        "blockOwner[blockId]",
        "inPlayerTerritory / inAiTerritory"
      ]
    },
    "actionCards": {
      "rule": "Gebäude- und Einheiten-Karten komponieren Icons soft (standIconPath / unitIconPath) und lesen Kosten/Stats live aus types.ts — keine eingebackenen Kachel-Werte.",
      "sync": [
        "syncPendingBuildUi",
        "syncUpgradeActionCard",
        "syncUnitActionCards"
      ],
      "liveBalance": [
        "BUILD_COST",
        "UPGRADE_COST",
        "productionPerMinute",
        "BUY_COST",
        "STEWARD_HIRE_GOLD",
        "PYRO_FIGHT_MERCH",
        "HOOLIGAN_ORDER_BEER"
      ]
    }
  },
  "deploy": {
    "sourceDir": "game/public/icons/",
    "rule": "Jeder Build/Deploy und jede neue Match-Erstellung muss locked Standarten + Bauplatz-Varianten aus diesem Register preloaded verwenden. Runtime tauscht Bauplatz-Icons automatisch bei Team-/Grau-Kontrolle. Action Cards laden Stand-/Unit-Icons soft und Balance-Werte live aus types.ts."
  },
  "scene": {
    "stadiumBg": {
      "path": "../assets/stadium-floodlight-derby-bg.jpg",
      "role": "match-backdrop",
      "locked": true,
      "notes": "Konzept-Agent stadium-floodlight-derby-bg — Cover, never distort"
    },
    "tribuneHeim": {
      "path": "../assets/tribune-block-blue.png",
      "role": "tribune",
      "team": "ksc",
      "locked": true
    },
    "tribuneNeutral": {
      "path": "../assets/tribune-block-grey.png",
      "role": "tribune",
      "team": "neutral",
      "locked": true
    },
    "tribuneGaeste": {
      "path": "../assets/tribune-block-red.png",
      "role": "tribune",
      "team": "vfb",
      "locked": true
    }
  }
}
